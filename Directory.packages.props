<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <MauiVersion>10.0.110</MauiVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="Sentry.Maui" Version="6.11.1"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Shiny.Hosting.Maui" Version="5.8.0-beta-0011"/>
        <PackageVersion Include="Shiny.Locations" Version="5.8.0-beta-0011"/>
        <PackageVersion Include="Shiny.Jobs" Version="5.8.0-beta-0011"/>
        <PackageVersion Include="Shiny.Notifications" Version="5.8.0-beta-0011"/>
        <PackageVersion Include="Shiny.Extensions.Configuration" Version="5.8.0-beta-0011"/>
        <PackageVersion Include="Shiny.AppFunctions" Version="5.8.0-beta-0011"/>
        <PackageVersion Include="Shiny.Extensions.Localization.Generator" Version="2.0.1"/>
        <PackageVersion Include="Shiny.Extensions.MauiHosting" Version="5.3.1"/>
        <PackageVersion Include="Shiny.Extensions.DependencyInjection" Version="5.3.1"/>
        <PackageVersion Include="Shiny.Extensions.Reactive" Version="5.3.1"/>
        <PackageVersion Include="Shiny.Maui.Controls" Version="1.5.0-beta-0043"/>
        <PackageVersion Include="Shiny.Maui.Shell" Version="7.0.1"/>
        <PackageVersion Include="Shiny.Maui.Shell.UxDiversDialogs" Version="7.0.1"/>
        <PackageVersion Include="Shiny.Mediator.Maui" Version="6.10.0-beta-0001"/>
        <PackageVersion Include="Shiny.Mediator.Sentry" Version="6.10.0-beta-0001"/>
        <PackageVersion Include="Shiny.Mediator.AppFunctions" Version="6.10.0-beta-0001"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="14.0.0"/>
        <PackageVersion Include="Shiny.Extensions.Serialization" Version="5.3.1"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.12.26421.1"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Driver" Version="0.1.0-preview.12.26421.1"/>
        <PackageVersion Include="coverlet.collector" Version="10.1.0"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
        <PackageVersion Include="Imposter" Version="0.1.11"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="TUnit" Version="1.72.4"/>
    </ItemGroup>
</Project>